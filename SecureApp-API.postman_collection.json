    {
      "name": "Session Validation (SessionValidationFilter)",
      "description": "Tests for the SessionValidationFilter — validates that requests without a valid session are rejected with HTTP 401.",
      "item": [
        {
          "name": "Dashboard - No Session (401 Unauthorized)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Clear cookies to simulate no session",
                  "pm.cookies.clear();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Session invalid error response', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('ERROR');",
                  "    pm.expect(jsonData.message).to.eql('Session invalid or expired');",
                  "    pm.expect(jsonData).to.have.property('timestamp');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
